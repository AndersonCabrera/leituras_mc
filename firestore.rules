rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAutenticado() {
      return request.auth != null;
    }

    function getDadosUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAutenticado() && getDadosUsuario().cargo == 'super_admin';
    }

    function isGestorDaAdministradora(idAdminPayload) {
      let user = getDadosUsuario();
      return isAutenticado() && user.cargo == 'admin' && user.id_administradora == idAdminPayload;
    }

    // 1. Configuracoes de Marca
    match /configuracoes_marca/{adminId} {
      allow read: if isAutenticado();
      allow create: if isSuperAdmin();
      allow update, delete: if isSuperAdmin() || isGestorDaAdministradora(adminId);
    }

    // 2. Administradoras
    match /administradoras/{adminId} {
      allow read: if isAutenticado();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isGestorDaAdministradora(adminId);
      allow delete: if isSuperAdmin();
    }

    // 3. Usuarios
    match /usuarios/{userId} {
      allow read: if isAutenticado();
      allow create: if isAutenticado();
      allow update, delete: if isSuperAdmin() || isGestorDaAdministradora(resource.data.id_administradora) || request.auth.uid == userId;
    }

    // 4. Predios — admin e super_admin podem tudo
    match /predios/{predioId} {
      allow read: if isAutenticado();
      allow create: if isSuperAdmin() || isGestorDaAdministradora(request.resource.data.admin_id);
      allow update, delete: if isSuperAdmin() || isGestorDaAdministradora(resource.data.admin_id);

      // Subcolecao de apartamentos
      match /apartamentos/{apartamentoId} {
        allow read: if isAutenticado();
        allow create, update, delete: if isSuperAdmin() || isGestorDaAdministradora(get(/databases/$(database)/documents/predios/$(predioId)).data.admin_id);
      }
    }

    // 5. Leituras
    match /leituras/{leituraId} {
      allow read: if isAutenticado();
      allow create: if isAutenticado() &&
                    request.resource.data.keys().hasAll(['condominio', 'apartamento', 'medidor', 'leitura_atual']) &&
                    (request.resource.data.consumo == null || request.resource.data.consumo >= 0 || request.resource.data.correcao_manual == true);
      allow update: if isAutenticado();
      allow delete: if isSuperAdmin() || isAutenticado() && getDadosUsuario().cargo == 'admin';
    }

    // 6. Notificacoes — admin pode gerenciar as suas
    match /notificacoes_enviadas/{notificacaoId} {
      allow read: if isSuperAdmin() || isGestorDaAdministradora(resource.data.id_administradora);
      allow create: if isSuperAdmin() || isGestorDaAdministradora(request.resource.data.id_administradora);
      allow update, delete: if false;
    }

    // 7. Assinaturas
    match /assinaturas/{idAdministradora} {
      allow read: if isAutenticado() && (isSuperAdmin() || isGestorDaAdministradora(idAdministradora));
      allow write: if isSuperAdmin();
    }

    // 8. Pagamentos
    match /pagamentos/{pagamentoId} {
      allow read: if isAutenticado();
      allow write: if isSuperAdmin();
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
