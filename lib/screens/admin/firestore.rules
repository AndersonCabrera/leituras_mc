rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAutenticado() {
      return request.auth != null;
    }

    function getDadosUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAutenticado() && getDadosUsuario().cargo == 'super_admin';
    }

    function isGestorDaAdministradora(idAdminPayload) {
      let user = getDadosUsuario();
      return isAutenticado() && user.cargo == 'admin' && user.id_administradora == idAdminPayload;
    }

    match /configuracoes_marca/{adminId} {
      allow read: if isAutenticado();
      allow update: if isGestorDaAdministradora(adminId) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['plano_premium']));
      allow create, delete: if isSuperAdmin();
    }

    match /administradoras/{adminId} {
      allow read: if isAutenticado();
      allow write: if isSuperAdmin();
    }

    match /usuarios/{userId} {
      allow read: if isAutenticado();
      allow create: if isAutenticado();
      allow update, delete: if isSuperAdmin() || isGestorDaAdministradora(resource.data.id_administradora);
    }

    match /predios/{predioId} {
      allow read: if isAutenticado();
      allow create: if isGestorDaAdministradora(request.resource.data.admin_id);
      allow update, delete: if isGestorDaAdministradora(resource.data.admin_id);
    }

    match /leituras/{leituraId} {
      allow read: if isAutenticado();
      allow create: if isAutenticado() &&
                    request.resource.data.keys().hasAll(['condominio', 'apartamento', 'medidor', 'leitura_atual']) &&
                    (request.resource.data.consumo == null || request.resource.data.consumo >= 0 || request.resource.data.correcao_manual == true);
      allow update: if isAutenticado();
      allow delete: if isAutenticado() && getDadosUsuario().cargo == 'admin';
    }

    match /notificacoes_enviadas/{notificacaoId} {
      allow read: if isGestorDaAdministradora(resource.data.id_administradora) || isSuperAdmin();
      allow create: if isGestorDaAdministradora(request.resource.data.id_administradora) || isSuperAdmin();
      allow update, delete: if false;
    }

    match /assinaturas/{idAdministradora} {
      allow read: if isAutenticado() && (isGestorDaAdministradora(idAdministradora) || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /pagamentos/{pagamentoId} {
      allow read: if isAutenticado();
      allow write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
